{
	"name": "prognocik-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"fsd": "node .agents/skills/frontend-fsd/scripts/fsd-check.mjs src --warn-only",
		"check": "npm run typecheck && npm run lint && node --experimental-strip-types --no-warnings scripts/gen-tokens.mjs src/shared/config/tokens.ts --css src/app/styles/theme.css --check",
		"fix": "npm run lint:fix && npm run format:fix",
		"gen:tokens": "node --experimental-strip-types --no-warnings scripts/gen-tokens.mjs src/shared/config/tokens.ts --css src/app/styles/theme.css --md docs/DESIGN.md"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.6.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.53.0",
		"motion": "^14.0.0",
		"ogl": "^1.0.11",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.2.0",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.15.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.34.0",
		"@typescript-eslint/parser": "^8.34.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^4.4.3",
		"eslint-plugin-boundaries": "^5.0.1",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.4.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.30.1",
		"vite": "^8.3.4"
	}
}
